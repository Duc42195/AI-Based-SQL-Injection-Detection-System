# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local env / secrets
.env

# Data artifacts (keep dir structure via .gitkeep, ignore contents)
data/**/*.csv
data/**/*.jsonl
data/**/*.db
data/**/*.parquet
data/**/*.txt

# Model binaries (versioned dirs tracked via metadata.json, weights ignored)
models/**/*.pkl
models/**/*.joblib
models/**/*.bin
models/**/*.pt
models/**/*.safetensors
models/**/*.json
models/**/*.txt
# Exception: keep the small metadata.json describing each versioned model
!models/**/metadata.json
# Architecture-comparison candidates: track the folder + metadata/vocab/config,
# heavy weights (*.bin/*.pt/*.joblib) stay ignored above and live on HF.

# Notebook checkpoints
.ipynb_checkpoints/

# MLOps: keep the data-version registry (small, lineage-critical), ignore the
# review-queue database and confirmed-label ledger (regenerated per round).
!data/versions/**/*.json
data/*.db
report/metrics/continual_learning/experiment_queue.db
report/metrics/continual_learning/experiment_confirmed_labels.jsonl
# Demo-reset archive: models moved aside by POST /mlops/reset
models/_archive/
.run/
models/registry.json
